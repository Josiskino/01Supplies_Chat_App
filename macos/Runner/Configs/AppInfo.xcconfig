// Application-level settings for the Runner target.

// Nom de l'application, également utilisé comme titre de la fenêtre Flutter.
// `bootstrap()` le remplace au lancement par `FlavorConfig.appName`, afin que la
// fenêtre indique l'environnement (« 01 Chat Dev »).
PRODUCT_NAME = 01 Chat

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.zeroonesupplies.chat

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 01Supplies. All rights reserved.
