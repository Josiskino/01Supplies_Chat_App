<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Connexions sortantes. Absent du template `flutter create` : sans cette
	     clé, le sandbox macOS bloque silencieusement toute requête HTTP et tout
	     WebSocket — l'app se comporte comme si le serveur ne répondait jamais. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Requis par le service VM de Flutter (hot reload, DevTools) en debug. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Lecture des fichiers choisis par l'utilisateur : nécessaire dès que la
	     messagerie permettra de joindre une pièce jointe. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
